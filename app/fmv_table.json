    "irs_pub_561": {
      "title": "IRS Publication 561 — Determining the Value of Donated Property",
      "url": "https://www.irs.gov/pub/irs-pdf/p561.pdf",
      "html_url": "https://www.irs.gov/forms-pubs/about-publication-561",
      "note": "Defines fair market value and the methods the IRS expects taxpayers to use for non-cash donations."
    },
    "irs_pub_526": {
      "title": "IRS Publication 526 — Charitable Contributions",
      "url": "https://www.irs.gov/pub/irs-pdf/p526.pdf",
      "html_url": "https://www.irs.gov/forms-pubs/about-publication-526",
      "note": "Rules for what is deductible, recordkeeping, the 'good used condition or better' rule for clothing/household items."
    },
    "irs_form_8283": {
      "title": "IRS Form 8283 — Noncash Charitable Contributions",
      "url": "https://www.irs.gov/pub/irs-pdf/f8283.pdf",
      "instructions_url": "https://www.irs.gov/pub/irs-pdf/i8283.pdf",
      "note": "Required when total non-cash deduction exceeds $500. Section A for items < $5,000; Section B + qualified appraisal for items > $5,000."
    },
    "salvation_army_guide": {
      "title": "Salvation Army Donation Value Guide",
      "url": "https://satruck.org/donation-value-guide",
